# Telegram bot token (BotFather). Keep secret.
BOT_TOKEN=put_your_telegram_bot_token_here

# Public HTTPS base URL of this Render Web Service, no trailing slash.
# Example: https://test-bot-example.onrender.com
WEBHOOK_BASE_URL=https://your-test-bot.onrender.com

# Shared secret used to verify Telegram webhook requests.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace_with_a_random_secret

# Optional webhook route. Keep default unless you have a reason to change it.
WEBHOOK_PATH=/telegram/webhook

# Public HTTPS URL of the Attheme Generator API.
ATTHEME_API_URL=https://your-attheme-api.onrender.com

# Must exactly match API_KEY on the Attheme API service.
ATTHEME_API_KEY=replace_with_the_same_long_random_api_key

# Render sets PORT automatically. Local default:
PORT=10000
LOG_LEVEL=INFO
