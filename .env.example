# Telegram bot token. Keep this secret; never commit your real .env file.
BOT_TOKEN=put_your_telegram_bot_token_here

# Base URL of ThemeGram Auto Attheme Generator API (without trailing slash).
# Local example:
ATTHEME_API_URL=http://127.0.0.1:8000

# Must match API_KEY configured on the API server.
ATTHEME_API_KEY=replace_with_the_same_long_random_api_key

# Optional: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
